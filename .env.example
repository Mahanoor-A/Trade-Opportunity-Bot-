# Server-side OpenAI API key. Never expose this in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Neon PostgreSQL connection string. Keep server-side; never expose to a browser.
DATABASE_URL=

# Shared read-only Supabase connection for both existing market-data tables.
SUPABASE_MARKET_DATA_URL=
SUPABASE_MARKET_DATA_KEY=

# Server-side Twelve Data API key. Never expose this to browser code.
TWELVE_DATA_API_KEY=

# Shared workspace identifier for the standalone open app.
OPEN_APP_ADVISOR_ID=public

# Optional origin allowlist, comma-separated.
ALLOWED_ORIGINS=
